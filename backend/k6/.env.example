# Copy to .env: cp backend/k6/.env.example backend/k6/.env

# --- API (read inside scripts via dotenv.js) ---
BASE_URL=https://money-mate-neon-beta.vercel.app
K6_EMAIL=
K6_PASSWORD=

# --- Stress script tuning ---
K6_ABORT_ERROR_RATE=0.25
K6_STRESS_PEAK_VUS=300
K6_ERROR_SAMPLES_PER_ENDPOINT=5
K6_LOG_ERROR_BODIES=false

# --- Grafana k6 web dashboard ---
# K6_WEB_DASHBOARD=true
# K6_WEB_DASHBOARD_OPEN=true
# K6_WEB_DASHBOARD_EXPORT=backend/k6/report.html
