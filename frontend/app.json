{
  "expo": {
    "name": "MoneyMate",
    "slug": "MoneyMate",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "scheme": "moneymate",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bohdanhashchuk.moneymate"
    },
    "android": {
      "package": "com.bohdanhashchuk.moneymate",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "MoneyMate needs camera to scan receipts."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "MoneyMate needs photo access to upload receipts."
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.1044437157993-3q2s17fmbf2th1vob36sb9krpjujb7cs"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "apiUrl": "https://money-mate-neon-beta.vercel.app",
      "googleClientIdIos": "1044437157993-3q2s17fmbf2th1vob36sb9krpjujb7cs.apps.googleusercontent.com",
      "googleClientIdAndroid": "1044437157993-qtqt3o9nansbr9t1u3cf4dvahdd1bk9r.apps.googleusercontent.com",
      "googleClientIdWeb": "1044437157993-soq2bklhq1hu4rpuihlitq5iq8bq3bpi.apps.googleusercontent.com",
      "revenueCatApiKey": "test_RJwOTgMMKBDLgAMlWQBSmVWcdji",
      "revenueCatIosApiKey": "test_RJwOTgMMKBDLgAMlWQBSmVWcdji",
      "revenueCatAndroidApiKey": "test_RJwOTgMMKBDLgAMlWQBSmVWcdji",
      "revenueCatEntitlementId": "moneymate_pro",
      "router": {},
      "eas": {
        "projectId": "a16b5b08-2e3d-4810-9f4d-0d90d7c9cafa"
      }
    }
  }
}
